# Server Configuration
PORT=3000

# Meta Webhook Verification Token
# A custom secret string of your choice. Enter this exact same string in the Meta App Dashboard when setting up your Webhook.
META_VERIFY_TOKEN=my_custom_random_verification_token_123

# Meta App Secret
# Found in Meta Developer Portal -> Your App -> App settings -> Basic -> App Secret.
# Used to verify the HMAC-SHA256 signature (x-hub-signature-256) of incoming webhook payloads.
META_APP_SECRET=your_meta_app_secret_here

# (Optional) Graph API Credentials - Required when sending reply messages back to WhatsApp / Instagram
# META_ACCESS_TOKEN=your_system_user_or_page_access_token
# META_WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
