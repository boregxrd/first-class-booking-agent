{
  "name": "first-class-booking-agent",
  "version": "1.0.0",
  "description": "Meta Webhooks (Instagram DM & WhatsApp) booking agent on Cloudflare Workers",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc -p src/llm-integration/tests/tsconfig.json",
    "test": "tsx --test src/llm-integration/tests/*.test.ts src/calendar/*.test.ts src/bookings/*.test.ts",
    "test:calendar:integration": "tsx --test integration-tests/google-calendar.test.ts",
    "chat:setup": "node scripts/chat.mjs --setup",
    "chat": "node scripts/chat.mjs",
    "test:agent:integration": "node scripts/chat.mjs --test"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261004.1",
    "@types/node": "^22.20.4",
    "miniflare": "^3.20250718.3",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "wrangler": "^4.147.0"
  }
}
