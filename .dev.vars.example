# Copy to ignored .dev.vars locally; use Worker secrets for deployed credentials.
META_VERIFY_TOKEN=replace_with_random_verification_token
META_APP_SECRET=replace_with_meta_app_secret

# Observe first; test mode accepts only the exact scoped sender IDs below.
META_MESSAGING_MODE=observe
# META_TEST_INSTAGRAM_SENDER_IDS=your_instagram_scoped_sender_id
# META_TEST_WHATSAPP_SENDER_IDS=your_whatsapp_sender_id_digits_only

# Pick a supported Graph API version in the Meta app dashboard.
META_GRAPH_API_VERSION=v23.0
# META_INSTAGRAM_ACCOUNT_ID=authorized_instagram_business_id
# META_INSTAGRAM_ACCESS_TOKEN=instagram_login_access_token
# META_INSTAGRAM_TOKEN_EXPIRES_AT=2026-12-01T00:00:00Z
# META_WHATSAPP_PHONE_NUMBER_ID=whatsapp_phone_number_id
# META_WHATSAPP_ACCESS_TOKEN=whatsapp_access_token
# META_WHATSAPP_TOKEN_EXPIRES_AT=2026-12-01T00:00:00Z

# Keep disabled until templates, number, test allowlist and Calendar are ready.
WHATSAPP_NOTIFICATIONS_ENABLED=false
# WHATSAPP_CONFIRMATION_TEMPLATE=approved_confirmation_template_name
# WHATSAPP_REMINDER_TEMPLATE=approved_reminder_template_name

# OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4.1-mini
# Optional protected direct-chat endpoint; use a random token of at least 32 bytes.
# DIRECT_CHAT_TOKEN=your_random_test_token

# Google Calendar API (service account; calendar shared with this account).
# GOOGLE_CALENDAR_ID=your_calendar_id@group.calendar.google.com
# GOOGLE_CLIENT_EMAIL=your-service-account@project-id.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
