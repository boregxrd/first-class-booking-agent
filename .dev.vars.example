# Cloudflare Workers Local Secrets Template
# Rename or copy this to `.dev.vars` for local development.

# Meta Webhook Verify Token (configured in Meta App Dashboard)
META_VERIFY_TOKEN=my_custom_random_verification_token_123

# Meta App Secret (Meta Developer Portal -> App Settings -> Basic -> App Secret)
META_APP_SECRET=your_meta_app_secret_here

# (Optional) Future bindings
# META_ACCESS_TOKEN=your_system_user_token
# META_PHONE_NUMBER_ID=your_phone_number_id

# Receive/log metadata without replying by default while the existing bot is active.
META_MESSAGING_MODE=observe
# Once the test sender's scoped ID is visible in verified webhook logs:
# META_MESSAGING_MODE=test
# META_TEST_INSTAGRAM_SENDER_IDS=your_instagram_scoped_sender_id
# META_TEST_WHATSAPP_SENDER_IDS=your_whatsapp_sender_id
# OPENAI_API_KEY=your_openai_api_key

# Google Calendar API (Service Account)
# GOOGLE_CALENDAR_ID=your_calendar_id@group.calendar.google.com
# GOOGLE_CLIENT_EMAIL=your-service-account@project-id.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Model client (set the API key as a Worker secret in production)
# OPENAI_API_KEY=your_openai_api_key
# OPENAI_MODEL=gpt-4.1-mini
