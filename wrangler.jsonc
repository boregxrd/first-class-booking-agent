{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "first-class-booking-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dwc-booking-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "queues": {
    "producers": [{ "binding": "MESSAGE_QUEUE", "queue": "dwc-messages" }],
    "consumers": [{ "queue": "dwc-messages", "max_batch_size": 1, "max_batch_timeout": 1, "max_retries": 5, "dead_letter_queue": "dwc-messages-dlq" }]
  },
  "observability": {
    "enabled": true
  }
}
