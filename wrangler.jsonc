{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "first-class-booking-agent",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		"META_INSTAGRAM_ACCOUNT_ID": "17841450775304205",
		"META_GRAPH_API_VERSION": "v26.0",
		"META_MESSAGING_MODE": "test",
		"META_TEST_INSTAGRAM_SENDER_IDS": "1078653611459615",
		"WHATSAPP_NOTIFICATIONS_ENABLED": "false"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "dwc-booking-db",
			"database_id": "a99df476-5b40-4efc-8b9e-f638661246e2",
			"migrations_dir": "migrations"
		}
	],
	"triggers": {
		"crons": [
			"* * * * *"
		]
	},
	"queues": {
		"producers": [
			{
				"binding": "MESSAGE_QUEUE",
				"queue": "dwc-messages"
			}
		],
		"consumers": [
			{
				"queue": "dwc-messages",
				"max_batch_size": 1,
				"max_batch_timeout": 1,
				"max_retries": 5,
				"dead_letter_queue": "dwc-messages-dlq"
			}
		]
	},
	"observability": {
		"enabled": true
	}
}
